# Supabase — Project Settings → API. Cheia service_role rămâne DOAR pe server (Netlify env), niciodată în browser.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Google Sheets — tabelul live cu rezervări și comenzi (vezi README → Google Sheets)
GOOGLE_SHEETS_URL=
GOOGLE_SHEETS_SECRET=

# Poster (casa din restaurant) — comenzile de pe site ajung pe terminal ca „comenzi online”
# Tokenul „Personal integration” din Poster: Access → Integrations. DOAR pe server, niciodată în cod.
POSTER_TOKEN=
# Opțional: localul (altfel se ia primul) și potriviri manuale de produse {"id-site": product_id}
POSTER_SPOT_ID=
POSTER_PRODUCT_MAP=
# Implicit pe casă ajung doar comenzile cu livrare; „false” trimite și comenzile cu ridicare
POSTER_ONLY_DELIVERY=

# Parola pentru /ro/admin (comenzi și rezervări)
ADMIN_PASSWORD=

# Opțional: notificări pe Telegram la fiecare comandă/rezervare
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# URL-ul public al site-ului (pentru SEO / Open Graph)
NEXT_PUBLIC_SITE_URL=https://casinia.md
