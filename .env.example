# Supabase — Project Settings → API. Cheia service_role rămâne DOAR pe server (Netlify env), niciodată în browser.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Google Sheets — tabelul live cu rezervări și comenzi (vezi README → Google Sheets)
GOOGLE_SHEETS_URL=
GOOGLE_SHEETS_SECRET=

# Parola pentru /ro/admin (comenzi și rezervări)
ADMIN_PASSWORD=

# Opțional: notificări pe Telegram la fiecare comandă/rezervare
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# URL-ul public al site-ului (pentru SEO / Open Graph)
NEXT_PUBLIC_SITE_URL=https://casinia.md
